     fn stage_casefold_superblock_byte(fs: &Filesystem, buf: &mut BlockBuffer, field: usize) {
         let bs = u64::from(fs.sb.block_size());
         let offset = (crate::superblock::SUPERBLOCK_OFFSET % bs) as usize;
