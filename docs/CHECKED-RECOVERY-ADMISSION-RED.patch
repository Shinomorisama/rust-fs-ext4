+        #[test]
+        fn unsupported_checksum_v3_journal_is_refused_without_device_io() {
+            use crate::jbd2::{self, JbdIncompat, JournalSuperblock};
+
+            let image = journalled();
+            let fs = Filesystem::mount_lazy(image.clone()).unwrap();
+            let inode =
+                crate::inode::Inode::parse(&fs.read_inode_raw(fs.sb.journal_inode).unwrap())
+                    .unwrap();
+            let offset = jbd2::journal_block_to_physical(&fs, &inode, 0)
+                .unwrap()
+                .unwrap()
+                * u64::from(BS);
+            drop(fs);
+
+            // Same checksum-v3 journal declaration as tests/jbd2_checksums_oracle.rs.
+            let mut raw = [0u8; 1024];
+            image.read_at(offset, &mut raw).unwrap();
+            let bits = u32::from_be_bytes(raw[0x28..0x2c].try_into().unwrap());
+            raw[0x28..0x2c].copy_from_slice(&(bits | JbdIncompat::CSUM_V3.bits()).to_be_bytes());
+            raw[0x50] = jbd2::JBD2_CRC32C_CHKSUM;
+            raw[0xfc..0x100].fill(0);
+            let checksum = crate::checksum::linux_crc32c(!0, &raw);
+            raw[0xfc..0x100].copy_from_slice(&checksum.to_be_bytes());
+            let journal = JournalSuperblock::parse(&raw).unwrap();
+            assert!(journal.is_clean() && journal.uses_csum_v3());
+            assert_eq!(journal.checksum_declaration_error(), None);
+            assert_eq!(journal.checksum, checksum);
+            image.write_at(offset, &raw).unwrap();
+            assert_ne!(on_disk(&image).state & crate::superblock::EXT4_VALID_FS, 0);
+            assert!(!needs_recovery(&image));
+
+            let before = image.bytes.lock().unwrap().clone();
+            let dev = std::sync::Arc::new(Failing::new(image.clone(), usize::MAX));
+            let refusal = Filesystem::mount_recovering(dev.clone());
+            assert!(
+                matches!(refusal, Err(Error::Unsupported(msg)) if msg.starts_with("checked lifecycle supports plain JBD2 only")),
+                "expected the checked lifecycle to refuse this journal, got {:?}",
+                refusal.err()
+            );
+            assert!(
+                *image.bytes.lock().unwrap() == before,
+                "refusal changed bytes"
+            );
+            let writes = dev.writes.load(Ordering::SeqCst);
+            let flushes = dev.flushes.load(Ordering::SeqCst);
+            assert_eq!(
+                (writes, flushes),
+                (0, 0),
+                "checked refusal must perform zero writes and flushes, including drop"
+            );
+        }
