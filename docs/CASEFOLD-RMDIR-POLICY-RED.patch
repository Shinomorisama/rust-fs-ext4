+#[test]
+fn all_entries_keep_volume_refusal_before_overlong_names() {
+    let mut observations = 0;
+    for flavor in [
+        features::FsFlavor::Ext2,
+        features::FsFlavor::Ext3,
+        features::FsFlavor::Ext4,
+    ] {
+        for bs in [1024, 4096] {
+            let (dev, fs, parent, _, clock) = specimen(flavor, bs);
+            let _fs = with_test_mount(fs, |handle, fs| {
+                let before = metadata(fs);
+                let counts = counters(&dev);
+                clock.now.store(SECOND, Ordering::SeqCst);
+                dev.writable.store(false, Ordering::SeqCst);
+                for entry in ENTRIES {
+                    assert_eq!(
+                        call(fs, handle, parent.into(), entry, &[b'n'; 256]),
+                        Err(crate::error::errno::EROFS)
+                    );
+                    assert_eq!(metadata(fs), before);
+                    assert_eq!(counters(&dev), counts);
+                    observations += 1;
+                }
+                dev.writable.store(true, Ordering::SeqCst);
+            });
+        }
+    }
+    assert_eq!(observations, 30);
+    eprintln!("rmdir read-only before long name: all {observations} observations retained");
+}
