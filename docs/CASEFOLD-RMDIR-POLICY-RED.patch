+fn mixed_at(entry: Entry) {
+    let mut observations = 0;
+    for flavor in [
+        features::FsFlavor::Ext2,
+        features::FsFlavor::Ext3,
+        features::FsFlavor::Ext4,
+    ] {
+        for bs in [1024, 4096] {
+            let (dev, fs, parent, _, clock) = specimen(flavor, bs);
+            let _fs = with_test_mount(fs, |handle, fs| {
+                let before = metadata(fs);
+                let counts = counters(&dev);
+                let generation = fs.read_inode_verified(parent).unwrap().0.generation;
+                let stale = InodeRef::new(parent, generation ^ 1);
+                let regular = fs.resolve(b"/p/regular").unwrap();
+                let regular_generation = fs.read_inode_verified(regular).unwrap().0.generation;
+                let mut slash = [b'n'; 256];
+                slash[255] = b'/';
+                let mut nul = [b'n'; 256];
+                nul[255] = 0;
+                clock.now.store(SECOND, Ordering::SeqCst);
+                for (dir, name, expected) in [
+                    (stale, &[b'n'; 256][..], crate::error::errno::ESTALE),
+                    (regular.into(), &[b'n'; 256], crate::error::errno::ENOTDIR),
+                    (
+                        InodeRef::new(regular, regular_generation ^ 1),
+                        &[b'n'; 256],
+                        crate::error::errno::ESTALE,
+                    ),
+                    (0u32.into(), &[b'n'; 256], crate::error::errno::ESTALE),
+                    (stale, &slash, crate::error::errno::EINVAL),
+                    (stale, &nul, crate::error::errno::EINVAL),
+                    (stale, b".", crate::error::errno::EINVAL),
+                    (stale, b"..", crate::error::errno::ENOTEMPTY),
+                    // Counted-name validation stays EINVAL despite syscall empty ENOENT.
+                    (stale, b"", crate::error::errno::EINVAL),
+                ] {
+                    assert_eq!(call(fs, handle, dir, entry, name), Err(expected));
+                    assert_eq!(metadata(fs), before);
+                    assert_eq!(counters(&dev), counts);
+                    observations += 1;
+                }
+            });
+        }
+    }
+    assert_eq!(observations, 54);
+    eprintln!(
+        "rmdir mixed parent/name entry={entry:?}: all 6 native profiles, {observations} observations"
+    );
+}
+#[test]
+fn rust_at_mixed_name_generation_priorities_are_retained() {
+    mixed_at(Entry::RustAt);
+}
+#[test]
+fn c_at_mixed_name_generation_priorities_are_retained() {
+    mixed_at(Entry::CAt);
+}
