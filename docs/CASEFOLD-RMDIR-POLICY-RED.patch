+#[test]
+fn all_entries_remove_255_byte_names_and_clear_c_errno() {
+    let mut removals = 0;
+    for flavor in [
+        features::FsFlavor::Ext2,
+        features::FsFlavor::Ext3,
+        features::FsFlavor::Ext4,
+    ] {
+        for bs in [1024, 4096] {
+            let (dev, fs, parent, _, clock) = specimen(flavor, bs);
+            let _fs = with_test_mount(fs, |handle, fs| {
+                for entry in ENTRIES {
+                    let name = [b'n'; 255];
+                    let path = format!("/p/{}", std::str::from_utf8(&name).unwrap());
+                    let ino = fs.apply_mkdir(&path, 0o750).unwrap();
+                    let before = fs.read_inode_verified(parent).unwrap().0;
+                    let counts = counters(&dev);
+                    clock.now.store(SECOND, Ordering::SeqCst);
+                    call(fs, handle, parent.into(), entry, &name).unwrap();
+                    assert!(matches!(fs.resolve(path.as_bytes()), Err(Error::NotFound)));
+                    assert!(!fs.inode_bit_is_set(ino).unwrap());
+                    assert_eq!(
+                        fs.read_inode_verified(parent).unwrap().0.links_count,
+                        before.links_count - 1
+                    );
+                    assert_eq!(counters(&dev), (counts.0 + 1, counts.1 + 1));
+                    removals += 1;
+                }
+            });
+        }
+    }
+    assert_eq!(removals, 30);
+    eprintln!("rmdir 255-byte boundary: all {removals} removals succeeded");
+}
